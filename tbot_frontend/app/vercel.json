{
  "rewrites": [
    {
      "source": "/deck/:slug/:key",
      "destination": "/api/deck-og?path=/deck/:slug/:key"
    },
    {
      "source": "/profile/:slug",
      "destination": "/api/deck-og?path=/profile/:slug"
    },
    {
      "source": "/decklists",
      "destination": "/api/deck-og?path=/decklists"
    },
    {
      "source": "/legacydecks",
      "destination": "/api/deck-og?path=/legacydecks"
    },
    {
      "source": "/legacy-decklists",
      "destination": "/api/deck-og?path=/legacy-decklists"
    },
    {
      "source": "/deckbuilders/:name",
      "destination": "/api/deck-og?path=/deckbuilders/:name"
    },
    {
      "source": "/cardinfo",
      "destination": "/api/deck-og?path=/cardinfo"
    },
    {
      "source": "/heroinfo",
      "destination": "/api/deck-og?path=/heroinfo"
    },
    {
      "source": "/keeporscrap",
      "destination": "/api/deck-og?path=/keeporscrap"
    },
    {
      "source": "/users",
      "destination": "/api/deck-og?path=/users"
    },
    {
      "source": "/tutorial",
      "destination": "/api/deck-og?path=/tutorial"
    },
    {
      "source": "/updates",
      "destination": "/api/deck-og?path=/updates"
    },
    {
      "source": "/termsofservice",
      "destination": "/api/deck-og?path=/termsofservice"
    },
    {
      "source": "/privacypolicy",
      "destination": "/api/deck-og?path=/privacypolicy"
    },
    {
      "source": "/",
      "destination": "/api/deck-og?path=/"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
